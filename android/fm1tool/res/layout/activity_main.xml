<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:liftOnScroll="true">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:paddingBottom="96dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- ======================================================== install -->
            <LinearLayout android:id="@+id/page_install"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView style="@style/FM1.Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/install_title" android:textAppearance="@style/FM1.Title" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:text="@string/install_body"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="14dp" android:background="@drawable/file_row"
                            android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                                android:src="@drawable/ic_file" app:tint="?attr/colorPrimary" />
                            <TextView android:id="@+id/fw_file" android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_marginStart="12dp"
                                android:layout_weight="1" android:text="@string/no_file"
                                android:textAppearance="?attr/textAppearanceBodyMedium" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" android:gravity="end" android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton android:id="@+id/fw_pick"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/pick_fw" app:icon="@drawable/ic_file" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/fw_install"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="8dp" android:enabled="false"
                                android:text="@string/install_go" app:icon="@drawable/ic_install" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView style="@style/FM1.Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/stock_title" android:textAppearance="@style/FM1.Title" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:text="@string/stock_body"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/stock_install"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="end" android:layout_marginTop="12dp"
                            android:text="@string/stock_go" app:icon="@drawable/ic_install" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ========================================================== units -->
            <LinearLayout android:id="@+id/page_units"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">

                <com.google.android.material.card.MaterialCardView style="@style/FM1.Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/units_title" android:textAppearance="@style/FM1.Title" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:text="@string/units_body"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="14dp" android:background="@drawable/file_row"
                            android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
                            <ImageView android:layout_width="28dp" android:layout_height="28dp"
                                android:src="@drawable/ic_units" app:tint="?attr/colorPrimary" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_marginStart="12dp" android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView android:id="@+id/unit_name" android:layout_width="match_parent"
                                    android:layout_height="wrap_content" android:text="@string/no_unit"
                                    android:textAppearance="?attr/textAppearanceBodyLarge" />
                                <TextView android:id="@+id/unit_detail" android:layout_width="match_parent"
                                    android:layout_height="wrap_content" android:visibility="gone"
                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" android:text="@string/slot"
                            android:textAppearance="?attr/textAppearanceLabelLarge" />
                        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:scrollbars="none">
                            <com.google.android.material.chip.ChipGroup android:id="@+id/slot_chips"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                app:selectionRequired="true" app:singleLine="true" app:singleSelection="true" />
                        </HorizontalScrollView>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:gravity="end" android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton android:id="@+id/unit_pick"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/pick_unit" app:icon="@drawable/ic_file" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/unit_send"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="8dp" android:enabled="false"
                                android:text="@string/send_unit" app:icon="@drawable/ic_install" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView style="@style/FM1.Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center_vertical" android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="@string/bank_title"
                                android:textAppearance="@style/FM1.Title" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/bank_read"
                                style="@style/Widget.Material3.Button.TextButton.Icon"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/bank_read" app:icon="@drawable/ic_refresh" />
                        </LinearLayout>
                        <LinearLayout android:id="@+id/bank_list" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="6dp" android:text="@string/bank_empty"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ========================================================= rescue -->
            <LinearLayout android:id="@+id/page_rescue"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <com.google.android.material.card.MaterialCardView style="@style/FM1.Card"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/colorErrorContainer">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/rescue_title" android:textAppearance="@style/FM1.Title"
                            android:textColor="?attr/colorOnErrorContainer" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:text="@string/rescue_body"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnErrorContainer" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="14dp" android:gravity="end" android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton android:id="@+id/rescue_check"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/rescue_check" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/rescue_go"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="8dp" android:backgroundTint="?attr/colorError"
                                android:textColor="?attr/colorOnError" android:text="@string/rescue_go"
                                app:icon="@drawable/ic_rescue" app:iconTint="?attr/colorOnError" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ===================================================== the status -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/status_card" style="@style/FM1.Card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSecondaryContainer">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/status" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/status_idle" android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="?attr/colorOnSecondaryContainer" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/cancel"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:enabled="false" android:text="@string/cancel" />
                    </LinearLayout>
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:max="100"
                        app:trackCornerRadius="4dp" app:trackThickness="6dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/log_toggle"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="@string/log" />
                    <TextView android:id="@+id/log" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:fontFamily="monospace"
                        android:textColor="?attr/colorOnSecondaryContainer" android:textIsSelectable="true"
                        android:textSize="12sp" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" app:menu="@menu/nav" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
